function state_hist = propagate_orbit_j2_thrust(t0, state0, at, t_vec)
% 简化轨道传播：二体 + J2摄动 + 沿迹常值小推力
% 接口与第二组轨道传播模块保持一致，便于联调替换
% 输入：
%   t0     : 初始时刻 (s)
%   state0 : 6×1 初始状态 [r0(km); v0(km/s)]
%   at     : 沿迹加速度大小 (km/s^2)
%   t_vec  : M×1 待输出状态的时刻序列
% 输出：
%   state_hist : 6×M 状态历史，每列对应一个时刻

    % 地球物理参数（联调时统一从default_config.m读取）
    mu = 398600.4418;   % km^3/s^2
    J2 = 1.0826359e-3;
    Re = 6378.137;      % km
    
    % 微分方程右端
    function dstate = ode_right(~, state)
        r = state(1:3);
        v = state(4:6);
        r_norm = norm(r);
        
        % 二体加速度
        a_two = -mu / r_norm^3 * r;
        
        % J2摄动加速度
        x = r(1); y = r(2); z = r(3);
        factor = 1.5 * J2 * mu * Re^2 / r_norm^5;
        a_j2 = factor * [
            x*(5*z^2/r_norm^2 - 1);
            y*(5*z^2/r_norm^2 - 1);
            z*(5*z^2/r_norm^2 - 3)
        ];
        
        % 沿迹推力加速度（沿速度方向）
        v_norm = norm(v);
        a_thrust = at * (v / v_norm);
        
        % 总加速度
        dstate = [v; a_two + a_j2 + a_thrust];
    end

    % 数值积分
    t_span = [t0, t_vec(end)];
    opts = odeset('RelTol', 1e-8, 'AbsTol', 1e-10);
    [t_out, state_out] = ode45(@ode_right, t_span, state0, opts);
    
    % 插值到指定时刻
    state_hist = zeros(6, length(t_vec));
    for i = 1:6
        state_hist(i, :) = interp1(t_out, state_out(:, i), t_vec, 'spline');
    end
end
