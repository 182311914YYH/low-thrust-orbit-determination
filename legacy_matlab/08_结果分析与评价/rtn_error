function [err_rtn, err_inertial] = rtn_error(state_pred, state_true)
% RTN误差计算模块：计算惯性系误差并转换到RTN轨道坐标系
% 输入：
%   state_pred : 6×M 预报状态 [r_pred; v_pred]
%   state_true : 6×M 真值状态 [r_true; v_true]
% 输出：
%   err_rtn    : 3×M RTN坐标系误差 [err_R; err_T; err_N]
%   err_inertial: 3×M 惯性系位置误差

    err_inertial = state_pred(1:3, :) - state_true(1:3, :);
    r_true = state_true(1:3, :);
    v_true = state_true(4:6, :);
    
    n_time = size(state_pred, 2);
    err_rtn = zeros(3, n_time);
    
    for i = 1:n_time
        C = rtn_frame_transform(r_true(:, i), v_true(:, i));
        err_rtn(:, i) = C' * err_inertial(:, i);
    end
end
