function C = rtn_frame_transform(r, v)
% RTN坐标系转换矩阵：将惯性系向量转换到RTN轨道坐标系
% RTN定义：R-径向（位置矢量方向），T-沿迹（速度方向投影到垂直于R的平面），N-法向（右手正交）
% 输入：
%   r   : 3×1 或 3×M 位置向量 (km)
%   v   : 3×1 或 3×M 速度向量 (km/s)
% 输出：
%   C   : 3×3×M 转换矩阵，C(:,:,i)为第i时刻的转换矩阵

    if size(r, 2) == 1
        r_norm = norm(r);
        v_norm = norm(v);
        
        R = r / r_norm;
        N = cross(r, v) / (r_norm * v_norm);
        T = cross(N, R);
        
        C = [R, T, N];
    else
        n_time = size(r, 2);
        C = zeros(3, 3, n_time);
        
        for i = 1:n_time
            r_i = r(:, i);
            v_i = v(:, i);
            r_norm = norm(r_i);
            v_norm = norm(v_i);
            
            R = r_i / r_norm;
            N = cross(r_i, v_i) / (r_norm * v_norm);
            T = cross(N, R);
            
            C(:, :, i) = [R, T, N];
        end
    end
end
